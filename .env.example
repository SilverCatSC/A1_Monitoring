APP_ENV=production
APP_TZ=Europe/Moscow
NETWORK_PROFILE=unknown
APP_BIND_PORT=18000
DB_BIND_PORT=15433
BROWSER_CDP_URL=
AUTH_ENABLED=true
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
# Use a long URL-safe alphanumeric value. Compose injects it into PostgreSQL and the app DSN.
DB_PASSWORD=replace-with-at-least-32-random-alphanumeric-characters
DATABASE_DSN=postgresql+psycopg2://monitor:replace-me@localhost:5432/a1_search_monitor
SOURCE_IMPORT_SOURCE=sheet
SOURCE_CSV_PATH=
SOURCE_GOOGLE_SHEET_EXPORT_URL=https://docs.google.com/spreadsheets/d/1afmXPsek-nu-1eH_n1PuYNIIIYcskJqwcSCIMHzJUNA/export?format=csv&gid=755848469
# Head office table. It is read-only: the monitoring system never writes to it.
HEAD_TABLE_GOOGLE_SHEET_EXPORT_URL=https://docs.google.com/spreadsheets/d/1s4RSn6oE8CeHzASjGHcQNQK6Hvhje6CUOaFmA3C5UFA/export?format=csv&gid=0
# Public A1Auto catalogue used as an independent third placement source.
COMPANY_SITE_CATALOG_URL=https://a1auto.ru/cars-for-sale/
COMPANY_SITE_AUDIT_DIR=./artifacts/company_site_audits
SCAN_PAGES_LIMIT=3
SCAN_INTERVAL_MINUTES=360
SCAN_ENABLED_ENGINES=auto_ru,avito
SCHEDULER_ENABLED=false
PLAYWRIGHT_HEADLESS=true
REQUEST_TIMEOUT_SECONDS=25
AUTO_RU_PAGE_DELAY_SECONDS=2.5
AVITO_PAGE_DELAY_SECONDS=2.5
SCAN_PAGE_PAUSE_MIN_SECONDS=0
SCAN_PAGE_PAUSE_MAX_SECONDS=0
SCAN_FILTER_PAUSE_MIN_SECONDS=0
SCAN_FILTER_PAUSE_MAX_SECONDS=0
TARGET_CLOSED_RETRY_SECONDS=5
RUN_EVERY_MINUTES=30
EVIDENCE_DIR=./artifacts
REPORT_RETENTION_DAYS=90
DEALER_DISCOVERY_ENABLED=true
DEALER_AUTO_URLS=https://auto.ru/diler/cars/all/a1_avto_moskva/,https://auto.ru/diler/lcv/all/a1_avto_moskva/
DEALER_AVITO_URLS="https://www.avito.ru/brands/a1auto/items/all/avtomobili?s=profile_search_show_all&sellerId=e4036231f69cc5cfc365db2f79600230"
DEALER_PAGES_LIMIT=3
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# Seller reconciliation is mandatory in a full local cycle (independent of legacy discovery toggle).
SELLER_PREFLIGHT_PAGES=5
SELLER_DIRECT_CHECKS_LIMIT=5
SELLER_DETAIL_CHECKS_LIMIT=100
HEAD_TABLE_AUDIT_DIR=./artifacts/head_table_audits
PUBLIC_REPORT_URL=https://silvercatsc.github.io/A1_Monitoring/
# Bitrix24 incoming webhook and target dialog are configured locally on MSI.
# Do not commit real values. The publish script is dry-run unless --send is supplied.
BITRIX_WEBHOOK_URL=
BITRIX_DIALOG_ID=
